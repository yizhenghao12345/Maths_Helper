# ---- AI 服务配置 ----
# 不配置 AI_API_KEY 时后端自动降级，不依赖 AI 也能运行
# 默认使用 DeepSeek v4 Flash（免费额度），只需配置 API Key 即可
AI_PROVIDER=deepseek
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# ---- 控制台密码 ----
# 不配置时默认 admin123
CONSOLE_PASSWORD=admin123

# ---- CORS（可选）----
# 追加允许的跨域来源，逗号分隔（本地开发 localhost:5173 已内置）
# CORS_ORIGINS=https://your-domain.com,https://another.com

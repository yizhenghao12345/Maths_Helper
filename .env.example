# ---- AI 服务配置 ----
# 不配置 AI_API_KEY 时后端自动降级，不依赖 AI 也能运行
# 默认使用 DeepSeek v4 Flash（免费额度），只需配置 API Key 即可
AI_PROVIDER=deepseek
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash
AI_FAST_MODEL=deepseek-v4-flash
AI_SLOW_MODEL=deepseek-reasoner

# ---- OCR 服务配置（可选）----
# 默认使用 MiniMax-M3（不配置 OCR_API_KEY 时自动降级到本地 Tesseract）
OCR_PROVIDER=minimax
OCR_API_KEY=your-minimax-api-key-here
OCR_BASE_URL=https://api.minimaxi.com/v1
OCR_MODEL=MiniMax-M3

# ---- 控制台密码 ----
# 不配置时默认 admin123
CONSOLE_PASSWORD=admin123

# ---- CORS（可选）----
# 追加允许的跨域来源，逗号分隔（本地开发 localhost:5173 已内置）
# CORS_ORIGINS=https://your-domain.com,https://another.com
